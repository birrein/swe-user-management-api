                  "});",
                  "",
                  "pm.test('user was updated', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.id).to.eql(pm.collectionVariables.get('user_id'));",
                  "  pm.expect(json.first_name).to.eql('Updated');",
                  "  pm.expect(json.role).to.eql('admin');",
                  "  pm.expect(json.active).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
