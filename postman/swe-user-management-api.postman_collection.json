                  "pm.test('user is inactive after delete', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.id).to.eql(pm.collectionVariables.get('user_id'));",
                  "  pm.expect(json.active).to.eql(false);",
                  "});"
