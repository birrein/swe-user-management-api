  "item": [
    {
      "name": "Smoke CRUD Flow",
      "item": [
        {
          "name": "01 Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Checks that the API is reachable."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('health payload is valid', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('ok');",
                  "  pm.expect(json.environment).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Create User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = `${Date.now()}_${Math.floor(Math.random() * 10000)}`;",
                  "pm.collectionVariables.set('test_username', `challenge_${suffix}`);",
                  "pm.collectionVariables.set('test_email', `challenge_${suffix}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('user_id', json.id);",
                  "",
                  "pm.test('created user has expected fields', function () {",
                  "  pm.expect(json.id).to.be.a('string');",
                  "  pm.expect(json.username).to.eql(pm.collectionVariables.get('test_username'));",
                  "  pm.expect(json.email).to.eql(pm.collectionVariables.get('test_email'));",
                  "  pm.expect(json.first_name).to.eql('Postman');",
                  "  pm.expect(json.last_name).to.eql('Smoke');",
                  "  pm.expect(json.role).to.eql('user');",
                  "  pm.expect(json.active).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{test_username}}\",\n  \"email\": \"{{test_email}}\",\n  \"first_name\": \"Postman\",\n  \"last_name\": \"Smoke\",\n  \"role\": \"user\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            },
            "description": "Creates a unique test user and stores the generated user id for subsequent requests."
          },
          "response": []
        },
        {
          "name": "03 Create Duplicate User - Expects 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', function () {",
                  "  pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test('error payload has detail', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.detail).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{test_username}}\",\n  \"email\": \"{{test_email}}\",\n  \"first_name\": \"Postman\",\n  \"last_name\": \"Duplicate\",\n  \"role\": \"user\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            },
            "description": "Verifies unique username/email handling."
          },
          "response": []
        },
        {
          "name": "04 List Active Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('list payload is paginated', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.items).to.be.an('array');",
                  "  pm.expect(json.total).to.be.a('number');",
                  "  pm.expect(json.skip).to.eql(0);",
                  "  pm.expect(json.limit).to.eql(50);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users?skip=0&limit=50&active=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ],
              "query": [
                {
                  "key": "skip",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "active",
                  "value": "true"
                }
              ]
            },
            "description": "Lists active users with pagination."
          },
          "response": []
        },
        {
          "name": "05 Get User by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('returned user matches stored id', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.id).to.eql(pm.collectionVariables.get('user_id'));",
                  "  pm.expect(json.active).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "{{user_id}}"
              ]
            },
            "description": "Reads the user created earlier in the flow."
